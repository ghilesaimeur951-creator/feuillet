{
  "name": "feuillet",
  "version": "1.0.0",
  "description": "Scanner de documents local-first : détection temps réel, redressement, filtres, PDF recherchables, OCR hors ligne et bibliothèque.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "preview": "bun scripts/serve.ts dist",
    "test": "bun test tests/unit",
    "test:e2e": "bun scripts/build.ts && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "bun scripts/lint.ts && prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
