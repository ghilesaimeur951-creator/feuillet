# Feuillet ne nécessite AUCUNE clé d'API ni aucun secret : tout fonctionne localement.
# Ces variables, toutes facultatives, ne concernent que les scripts de développement.

# Port du serveur de prévisualisation (bun run preview) — défaut 4173
PORT=4173

# Pour tester la caméra depuis un téléphone sur le réseau local, lancez :
#   bun run dev -- --https
# (certificat auto-signé généré dans .cert/, jamais versionné)
